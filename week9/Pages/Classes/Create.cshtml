@page
@model ceng382_25_26_202211058.Pages.Classes.CreateModel
@{
    ViewData["Title"] = "Create Class";
}

<h1>Create New Class</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="form-group mb-3">
                <label asp-for="Class.Name" class="control-label">Name</label>
                <input asp-for="Class.Name" class="form-control" />
                <span asp-validation-for="Class.Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Class.PersonCount" class="control-label">Person Count</label>
                <input asp-for="Class.PersonCount" class="form-control" type="number" />
                <span asp-validation-for="Class.PersonCount" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Class.Description" class="control-label">Description</label>
                <textarea asp-for="Class.Description" class="form-control"></textarea>
                <span asp-validation-for="Class.Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Class.IsActive" class="control-label">Is Active</label>
                <input asp-for="Class.IsActive" type="checkbox" />
                <span asp-validation-for="Class.IsActive" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 